# ============================================
# Supabase Configuration
# ============================================
# Get these from your Supabase dashboard: https://app.supabase.com
# Navigate to Settings > API to find your project URL and keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ============================================
# OAuth Configuration
# ============================================
# Configure OAuth providers in Supabase dashboard under Authentication > Providers
# DO NOT commit real secrets to this file—use .env.local for actual values
# See: https://supabase.com/docs/guides/auth/social-oauth

# Google OAuth (optional)
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id
# NEXT_PUBLIC_GOOGLE_CLIENT_SECRET=your-google-client-secret (server-only)

# Apple OAuth (optional)
# NEXT_PUBLIC_APPLE_CLIENT_ID=your-apple-client-id

# GitHub OAuth (optional)
# NEXT_PUBLIC_GITHUB_CLIENT_ID=your-github-client-id

# ============================================
# API Configuration
# ============================================
# NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api
# NEXT_PUBLIC_API_TIMEOUT=30000

# ============================================
# Web3 / Blockchain Configuration
# ============================================
# For DreamCoin smart contract integration
# NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=your-wallet-connect-project-id
# NEXT_PUBLIC_CONTRACT_ADDRESS=0x...
# NEXT_PUBLIC_NETWORK_ID=11155111  # Sepolia testnet (1 for mainnet)
# NEXT_PUBLIC_RPC_URL=https://sepolia.infura.io/v3/your-infura-key

# ============================================
# Application Settings
# ============================================
# NEXT_PUBLIC_APP_ENV=development
# NEXT_PUBLIC_ENABLE_DEBUG=false
# NEXT_PUBLIC_LOG_LEVEL=info

# ============================================
# IMPORTANT SECURITY NOTES
# ============================================
# 1. This file is version-controlled and public—use for default/example values ONLY
# 2. Create a .env.local file in apps/web/ for actual secrets (added to .gitignore)
# 3. Never commit real API keys, OAuth secrets, or private keys to the repository
# 4. In production, use your platform's secret management (GitHub Secrets, Vercel Env, etc.)
# 5. Rotate credentials if ever accidentally exposed
