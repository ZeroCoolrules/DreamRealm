{
  "extends": "../../tools/typescript-config/base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmitOnError": false,
    "skipLibCheck": true
