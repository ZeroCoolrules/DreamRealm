# ============================================
# DREAMCOIN ECONOMY - ENVIRONMENT CONFIG
# Copy this file to .env and fill in your values
# ============================================

# === REQUIRED: Deployment Private Key ===
# Your wallet private key (with 0x prefix) - KEEP THIS SECRET!
PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# === OPTIONAL: RPC URLs ===
# Ethereum Sepolia Testnet (deploy here first!)
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Ethereum Mainnet (only after testing!)
MAINNET_RPC_URL=https://eth-mainnet.public.blastapi.io

# Layer 2 Networks (alternative deployment options)
BASE_RPC_URL=https://mainnet.base.org
OPTIMISM_RPC_URL=https://mainnet.optimism.io
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc

# === OPTIONAL: Block Explorer API Keys (for contract verification) ===
ETHERSCAN_API_KEY=YOUR_ETHERSCAN_KEY
BASESCAN_API_KEY=YOUR_BASESCAN_KEY
OPTIMISM_API_KEY=YOUR_OPTIMISTIC_ETHERSCAN_KEY
ARBISCAN_API_KEY=YOUR_ARBISCAN_KEY

# === OPTIONAL: Token Parameters ===
DREAM_SUPPLY=21000000
CUPID_SUPPLY=100000000
SPARK_SUPPLY=10000000000
FORGE_SUPPLY=500000000
GUARD_SUPPLY=10000000

# === OPTIONAL: Gas Reporting ===
REPORT_GAS=false
